    local function updateScale()
        local vs=WS.CurrentCamera and WS.CurrentCamera.ViewportSize or Vector2.new(1280,720)
        local targetW=isM and (vs.X*0.90) or vs.X
        local targetH=isM and (vs.Y*0.80) or vs.Y
        local sx=targetW/W local sy=targetH/H
        local s=math.min(sx,sy,1)
        uiscale.Scale=math.max(s,MIN_SCALE)
    end
