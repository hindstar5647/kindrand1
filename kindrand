        local function selectByName(rawName)
            if not rawName or rawName=="" then play(SND.error) fST.Text="enter a username" fST.TextColor3=C.bd tgtHint.Text="" return end
            local name=string.gsub(rawName,"^%s+","") name=string.gsub(name,"%s+$","")
            if name=="" then play(SND.error) fST.Text="enter a username" fST.TextColor3=C.bd return end
            local found=nil
            for _,p in ipairs(P:GetPlayers()) do if p~=LP and string.lower(p.Name)==string.lower(name) then found=p break end end
            if not found then for _,p in ipairs(P:GetPlayers()) do if p~=LP and string.lower(p.DisplayName)==string.lower(name) then found=p break end end end
            if not found then
                local matches={}
                for _,p in ipairs(P:GetPlayers()) do
                    if p~=LP and string.lower(p.Name):sub(1,#name)==string.lower(name) then table.insert(matches,p) end
                end
                if #matches==1 then found=matches[1]
                elseif #matches>1 then play(SND.error) fST.Text="ambiguous — "..#matches.." players" fST.TextColor3=C.wn return end
            end
            if not found then
