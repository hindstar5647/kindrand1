-- =====================================================================
-- MAIN GUI — PURE BLACK
-- =====================================================================
local csStart, csStop

local function buildMainGUI()
    local SG=Instance.new("ScreenGui")
    SG.Name="VOIDH" SG.ResetOnSpawn=false SG.IgnoreGuiInset=true SG.DisplayOrder=100 SG.Parent=PG

    local vp = WS.CurrentCamera and WS.CurrentCamera.ViewportSize or Vector2.new(1280,720)
    local isM = IS_MOBILE

    local W,H = 520,560
    local MIN_SCALE = 0.62
    local baseSize = UDim2.new(0,W,0,H)
    local basePos = UDim2.new(.5,-W/2,.5,-H/2)

    local PAD = isM and 8 or 14
    local HEADER_H = isM and 46 or 56
    local TAB_H = isM and 30 or 32
    local TAB_GAP = 3
    local CONTENT_TOP = HEADER_H + PAD + TAB_H + (isM and 8 or 12)

    local holder=Instance.new("Frame")
    holder.Name="Holder" holder.BackgroundTransparency=1
    holder.Size=UDim2.new(1,0,1,0) holder.Position=UDim2.new(0,0,0,0) holder.Parent=SG
    local uiscale=Instance.new("UIScale") uiscale.Parent=holder

    local MF=Instance.new("Frame")
    MF.BackgroundColor3=C.panel MF.BorderSizePixel=0 MF.Active=true
    MF.Size=baseSize MF.Position=basePos MF.Parent=holder
    corner(MF,8) stroke(MF,C.stroke,1) MF.ClipsDescendants=true
    registerThemed(MF, "panel")

    local panelOpen=false
    local function openP()
        if panelOpen then return end
        panelOpen=true play(SND.open) MF.Visible=true
        if uiscale.Scale ~= 1 then
            uiscale.Scale=0
            TW:Create(uiscale, TweenInfo.new(.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Scale=1}):Play()
        end
    end
    local function closeP()
        if not panelOpen then return end
        panelOpen=false play(SND.close) MF.Visible=false
    end

    -- HEADER
    local HD=Instance.new("Frame")
    HD.Size=UDim2.new(1,0,0,HEADER_H) HD.BackgroundColor3=C.panel2 HD.BorderSizePixel=0 HD.Parent=MF HD.ZIndex=2
    registerThemed(HD, "panel2")

    -- thin bottom divider
    local hDiv=Instance.new("Frame")
    hDiv.Size=UDim2.new(1,0,0,1) hDiv.Position=UDim2.new(0,0,1,-1)
    hDiv.BackgroundColor3=C.stroke hDiv.BorderSizePixel=0 hDiv.ZIndex=3 hDiv.Parent=HD

    local hTitle=L(HD,"VOID",isM and 15 or 17,C.tx,FB)
    hTitle.Size=UDim2.new(1,-320,0,20) hTitle.Position=UDim2.new(0,PAD,0,isM and 8 or 12) hTitle.ZIndex=3
    local hSub=L(HD,"v9.7.0 · black edition",9,C.tx3,F)
    hSub.Size=UDim2.new(1,-320,0,12) hSub.Position=UDim2.new(0,PAD,0,isM and 26 or 34) hSub.ZIndex=3

    local XSIZE=isM and 28 or 26
    local XGAP=6
    local PILL_W=isM and 60 or 66
    local PILL_H=20
    local HUD_H=22 HUD_GAP=6
    local FPS_BOX_W=isM and 40 or 44 PING_BOX_W=isM and 40 or 44
    local HUD_W=FPS_BOX_W+HUD_GAP+PING_BOX_W
    local rightMargin=10
    local closeRight=-rightMargin
    local hudRight=-(rightMargin+XSIZE+XGAP)
    local pillRight=-(rightMargin+XSIZE+XGAP+HUD_W+XGAP)

    -- status pill
    local pill=Instance.new("Frame")
    pill.Size=UDim2.new(0,PILL_W,0,PILL_H) pill.AnchorPoint=Vector2.new(1,0)
    pill.Position=UDim2.new(1,pillRight,0,(HEADER_H-PILL_H)/2)
    pill.BackgroundColor3=C.input pill.BorderSizePixel=0 pill.ZIndex=3 pill.Parent=HD
    corner(pill,10) stroke(pill,C.stroke,1) registerThemed(pill, "input")
    local pillDot=Instance.new("Frame")
    pillDot.Size=UDim2.new(0,5,0,5) pillDot.Position=UDim2.new(0,8,0.5,-2.5)
    pillDot.BackgroundColor3=C.tx3 pillDot.BorderSizePixel=0 pillDot.ZIndex=4 pillDot.Parent=pill
    corner(pillDot,3)
    local pillTxt=L(pill,"idle",9,C.tx2,FM)
    pillTxt.Size=UDim2.new(1,-16,1,0) pillTxt.Position=UDim2.new(0,16,0,0) pillTxt.ZIndex=4

    -- HUD (FPS + PING)
    local hudBox=Instance.new("Frame")
    hudBox.BackgroundTransparency=1 hudBox.ZIndex=3 hudBox.AnchorPoint=Vector2.new(1,0)
    hudBox.Position=UDim2.new(1,hudRight,0,(HEADER_H-HUD_H)/2)
    hudBox.Size=UDim2.new(0,HUD_W,0,HUD_H) hudBox.Parent=HD

    local fpsBox=Instance.new("Frame")
    fpsBox.BackgroundColor3=C.input fpsBox.BorderSizePixel=0
    fpsBox.Size=UDim2.new(0,FPS_BOX_W,1,0) fpsBox.Parent=hudBox fpsBox.ZIndex=3 corner(fpsBox,4) stroke(fpsBox,C.stroke,1)
    registerThemed(fpsBox, "input")
    local fpsVal=L(fpsBox,"60",isM and 10 or 11,C.tx,FB)
    fpsVal.Size=UDim2.new(1,0,0,11) fpsVal.Position=UDim2.new(0,0,0,1) fpsVal.TextXAlignment=Enum.TextXAlignment.Center fpsVal.ZIndex=4
    local fpsLbl=L(fpsBox,"FPS",7,C.tx3,FM)
    fpsLbl.Size=UDim2.new(1,0,0,7) fpsLbl.Position=UDim2.new(0,0,0,12) fpsLbl.TextXAlignment=Enum.TextXAlignment.Center fpsLbl.ZIndex=4

    local pingBox=Instance.new("Frame")
    pingBox.BackgroundColor3=C.input pingBox.BorderSizePixel=0
    pingBox.Size=UDim2.new(0,PING_BOX_W,1,0) pingBox.Position=UDim2.new(0,FPS_BOX_W+HUD_GAP,0,0)
    pingBox.Parent=hudBox pingBox.ZIndex=3 corner(pingBox,4) stroke(pingBox,C.stroke,1)
    registerThemed(pingBox, "input")
    local pingVal=L(pingBox,"0",isM and 10 or 11,C.tx,FB)
    pingVal.Size=UDim2.new(1,0,0,11) pingVal.Position=UDim2.new(0,0,0,1) pingVal.TextXAlignment=Enum.TextXAlignment.Center pingVal.ZIndex=4
    local pingLbl=L(pingBox,"MS",7,C.tx3,FM)
    pingLbl.Size=UDim2.new(1,0,0,7) pingLbl.Position=UDim2.new(0,0,0,12) pingLbl.TextXAlignment=Enum.TextXAlignment.Center pingLbl.ZIndex=4

    registerUIPoller(function()
        local f=fps_val local p=ping_val
        local fs=tostring(f) if fpsVal.Text~=fs then fpsVal.Text=fs end
        local ps=tostring(p) if pingVal.Text~=ps then pingVal.Text=ps end
        if f>=50 then fpsVal.TextColor3=C.tx elseif f>=30 then fpsVal.TextColor3=C.wn else fpsVal.TextColor3=C.bd end
        if p<=80 then pingVal.TextColor3=C.tx elseif p<=200 then pingVal.TextColor3=C.wn else pingVal.TextColor3=C.bd end
    end)

    -- close button
    local XB=BTN(HD,"×",C.input,C.tx2)
    XB.Size=UDim2.new(0,XSIZE,0,XSIZE) XB.AnchorPoint=Vector2.new(1,0)
    XB.Position=UDim2.new(1,closeRight,0,(HEADER_H-XSIZE)/2)
    XB.TextSize=isM and 18 or 16 XB.ZIndex=3
    setBase(XB) hov(XB) registerThemed(XB, "input")
    onClick(XB, function() closeP() end)

    -- TABS
    local TB=Instance.new("Frame")
    TB.Size=UDim2.new(1,-PAD*2,0,TAB_H) TB.Position=UDim2.new(0,PAD,0,HEADER_H+PAD)
    TB.BackgroundTransparency=1 TB.Parent=MF TB.ZIndex=2
    local TL=Instance.new("UIListLayout")
    TL.FillDirection=Enum.FillDirection.Horizontal TL.Padding=UDim.new(0,TAB_GAP) TL.Parent=TB

    local tabOrder={"fling","move","chat","others"}
    local tabName={fling="Target",move="Move",chat="Chat",others="Others"}
    local tabs={} local pages={}
    local tabW=math.floor((W-PAD*2-TAB_GAP*3)/4)

    for i,n in ipairs(tabOrder) do
        local b=BTN(TB,tabName[n],C.panel,C.tx2)
        b.Size=UDim2.new(0,tabW,1,0) b.LayoutOrder=i b.TextSize=isM and 10 or 11 b.ZIndex=3
        b.BackgroundTransparency=1
        setBase(b) hov(b) tabs[n]=b registerThemed(b, "panel")

        -- underline indicator (hidden by default)
        local ul=Instance.new("Frame")
        ul.Name="indicator"
        ul.Size=UDim2.new(0.5,0,0,2) ul.Position=UDim2.new(0.25,0,1,-2)
        ul.BackgroundColor3=C.accent ul.BorderSizePixel=0 ul.ZIndex=4 ul.Visible=false
        ul.Parent=b corner(ul,1)

        local p=Instance.new("ScrollingFrame")
        p.Size=UDim2.new(1,-PAD*2,1,CONTENT_TOP) p.Position=UDim2.new(0,PAD,0,CONTENT_TOP)
        p.BackgroundTransparency=1 p.Visible=false p.Parent=MF
        p.BorderSizePixel=0 p.ScrollBarThickness=3 p.ScrollBarImageColor3=C.stroke2
        p.CanvasSize=UDim2.new(0,0,0,600) p.ScrollingEnabled=true
        p.ScrollingDirection=Enum.ScrollingDirection.Y p.ElasticBehavior=Enum.ElasticBehavior.WhenScrollable p.ZIndex=2
        pages[n]=p
    end

    -- drag state
    local currentDrag = nil
    local pillDrag = nil
    local pillStartClock = 0
    local headerDrag = nil
    local activeSliderUpdate = nil

    UIS.InputChanged:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.Touch and i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if currentDrag == "pill" and pillDrag then
            local d = i.Position - pillDrag.startI
            if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then pillDrag.moved = true end
            if pillDrag.moved then
                local nx = pillDrag.startP.X + d.X
                local ny = pillDrag.startP.Y + d.Y
                local maxX = vp.X - pillDrag.startSize.X
                local maxY = vp.Y - pillDrag.startSize.Y
                if maxX < 0 then maxX = 0 end if maxY < 0 then maxY = 0 end
                nx = math.clamp(nx, 0, maxX) ny = math.clamp(ny, 0, maxY)
                pillDrag.target.Position = UDim2.new(0, nx, 0, ny)
            end
        elseif currentDrag == "header" and headerDrag then
            local scale = uiscale.Scale
            if scale <= 0.01 then scale = 0.01 end
            local d = i.Position - headerDrag.startI
            local nx = (headerDrag.startScreen.X + d.X) / scale
            local ny = (headerDrag.startScreen.Y + d.Y) / scale
            local maxX = (vp.X / scale) - W
            local maxY = (vp.Y / scale) - H
            if maxX < 0 then maxX = 0 end if maxY < 0 then maxY = 0 end
            nx = math.clamp(nx, 0, maxX) ny = math.clamp(ny, 0, maxY)
            MF.Position = UDim2.new(0, nx, 0, ny)
        elseif currentDrag == "slider" and activeSliderUpdate then
            activeSliderUpdate(i)
        end
    end)

    HD.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
            headerDrag = { startI = i.Position, startScreen = MF.AbsolutePosition }
            currentDrag = "header"
        end
    end)
    HD.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
            headerDrag = nil
            if currentDrag == "header" then currentDrag = nil end
        end
    end)

    local built = {}
    local tabBuilders = {}

    local function switchTo(n)
        play(SND.tab)
        for k,v in pairs(tabs) do
            local ind=v:FindFirstChild("indicator")
            if k==n then
                v.TextColor3=C.tx v.BackgroundColor3=C.panel2 v:SetAttribute("baseColor",C.panel2)
                local s=v:FindFirstChildOfClass("UIStroke") if s then s.Color=C.stroke end
                if ind then ind.Visible=true end
            else
                v.TextColor3=C.tx2 v.BackgroundColor3=C.panel v:SetAttribute("baseColor",C.panel)
                local s=v:FindFirstChildOfClass("UIStroke") if s then s.Color=C.stroke end
                if ind then ind.Visible=false end
            end
        end
        for k,v in pairs(pages) do v.Visible = (k==n) end
        if not built[n] and tabBuilders[n] then
            built[n] = true
            tabBuilders[n]()
        end
    end

    for i,n in ipairs(tabOrder) do
        local b = tabs[n]
        local _last = 0
        b.MouseButton1Click:Connect(function()
            local now = tick()
            if now - _last < 0.2 then return end
            _last = now
            switchTo(n)
        end)
    end

    local innerW = W - PAD*2

    -- ---------------------------------------------------------------
    -- FLING TAB
    -- ---------------------------------------------------------------
    tabBuilders.fling = function()
        local fp=pages.fling
        fp.CanvasSize=UDim2.new(0,0,0,400)
        local faRow=Instance.new("Frame")
        faRow.Size=UDim2.new(1,0,0,54) faRow.BackgroundColor3=C.panel2 faRow.BorderSizePixel=0 faRow.Parent=fp
        corner(faRow,6) stroke(faRow,C.stroke,1) registerThemed(faRow, "panel2")

        local faTitle=L(faRow,"Fling All",12,C.tx,FM)
        faTitle.Size=UDim2.new(1,-146,0,14) faTitle.Position=UDim2.new(0,14,0,11)
        faStatus=L(faRow,"idle",10,C.tx3,F)
        faStatus.Size=UDim2.new(1,-146,0,12) faStatus.Position=UDim2.new(0,14,0,28)

        local faSB=BTN(faRow,"Start",C.accentD)
        faSB.Size=UDim2.new(0,58,0,28) faSB.Position=UDim2.new(1,-132,0,13)
        setBase(faSB) hov(faSB) registerThemed(faSB, "accentD")
        local faXB=BTN(faRow,"Stop",C.input,C.tx2)
        faXB.Size=UDim2.new(0,58,0,28) faXB.Position=UDim2.new(1,-68,0,13)
        setBase(faXB) hov(faXB) registerThemed(faXB, "input")
        onClick(faSB,function() play(SND.on) faStart() end)
        onClick(faXB,function() play(SND.off) faStop() end)

        local faWLlbl=L(fp,"Whitelist · comma separated",9,C.tx3,F)
        faWLlbl.Size=UDim2.new(1,0,0,12) faWLlbl.Position=UDim2.new(0,0,0,64)
        faWLBox=B(fp,"names to skip")
        faWLBox.Size=UDim2.new(1,0,0,26) faWLBox.Position=UDim2.new(0,0,0,78) faWLBox.TextSize=10
        faWLBox.Changed:Connect(function(prop)
            if prop~="Text" then return end
            faWL={}
            for n in string.gmatch(faWLBox.Text, "[^,]+") do
                local c=string.lower(string.gsub(string.gsub(n,"^%s+",""),"%s+$",""))
                if c~="" then faWL[c]=true end
            end
        end)

        local div1=Instance.new("Frame")
        div1.Size=UDim2.new(1,0,0,1) div1.Position=UDim2.new(0,0,0,116) div1.BackgroundColor3=C.stroke div1.Parent=fp

        local fTitle=L(fp,"Single Target",12,C.tx,FM)
        fTitle.Size=UDim2.new(1,0,0,14) fTitle.Position=UDim2.new(0,0,0,126)
        local fST=L(fp,"idle",10,C.tx3,F)
        fST.Size=UDim2.new(1,0,0,12) fST.Position=UDim2.new(0,0,0,142)

        local fCard=Instance.new("Frame")
        fCard.Size=UDim2.new(1,0,0,68) fCard.Position=UDim2.new(0,0,0,160)
        fCard.BackgroundColor3=C.panel2 fCard.BorderSizePixel=0 fCard.Parent=fp
        corner(fCard,6) stroke(fCard,C.stroke,1) registerThemed(fCard, "panel2")

        local AV=Instance.new("ImageLabel")
        AV.Size=UDim2.new(0,48,0,48) AV.Position=UDim2.new(0,10,0,10)
        AV.BackgroundColor3=C.input AV.BorderSizePixel=0 AV.Parent=fCard
        corner(AV,6) stroke(AV,C.stroke,1) registerThemed(AV, "input")

        local NL=L(fCard,"No target",12,C.tx,FM)
        NL.Size=UDim2.new(1,-70,0,14) NL.Position=UDim2.new(0,70,0,9)
        local UL=L(fCard,"—",10,C.tx3,F)
        UL.Size=UDim2.new(1,-70,0,12) UL.Position=UDim2.new(0,70,0,26)
        local AL=L(fCard,"age —",10,C.tx3,F)
        AL.Size=UDim2.new(0,100,0,12) AL.Position=UDim2.new(0,70,0,44)
        local FL=L(fCard,"friends —",10,C.tx3,F)
        FL.Size=UDim2.new(0,130,0,12) FL.Position=UDim2.new(1,-140,0,44)

        local TSTAT=L(fp,"",9,C.tx3,F)
        TSTAT.Size=UDim2.new(1,0,0,12) TSTAT.Position=UDim2.new(0,0,0,232)

        local actGap=6
        local actW=math.floor((innerW-actGap*3)/4)
        local headFlingBtn=BTN(fp,"Head",C.input,C.tx2)
        headFlingBtn.Size=UDim2.new(0,actW,0,30) headFlingBtn.Position=UDim2.new(0,0,0,250)
        setBase(headFlingBtn) hov(headFlingBtn) registerThemed(headFlingBtn, "input")
        local torsoFlingBtn=BTN(fp,"Torso",C.input,C.tx2)
        torsoFlingBtn.Size=UDim2.new(0,actW,0,30) torsoFlingBtn.Position=UDim2.new(0,actW+actGap,0,250)
        setBase(torsoFlingBtn) hov(torsoFlingBtn) registerThemed(torsoFlingBtn, "input")
        local tpBtn=BTN(fp,"Teleport",C.input,C.tx2)
        tpBtn.Size=UDim2.new(0,actW,0,30) tpBtn.Position=UDim2.new(0,(actW+actGap)*2,0,250)
        setBase(tpBtn) hov(tpBtn) registerThemed(tpBtn, "input")
        local spBtn=BTN(fp,"Spectate",C.input,C.tx2)
        spBtn.Size=UDim2.new(0,actW,0,30) spBtn.Position=UDim2.new(0,(actW+actGap)*3,0,250)
        setBase(spBtn) hov(spBtn) registerThemed(spBtn, "input")

        local function setToggle(b,on)
            if on then
                b.BackgroundColor3=C.accentD b:SetAttribute("baseColor",C.accentD) b.TextColor3=C.tx
                local s=b:FindFirstChildOfClass("UIStroke") if s then s.Color=C.accent end
            else
                b.BackgroundColor3=C.input b:SetAttribute("baseColor",C.input) b.TextColor3=C.tx2
                local s=b:FindFirstChildOfClass("UIStroke") if s then s.Color=C.stroke end
            end
        end

        local function stopSpec()
            specOn=false
            if specConn then specConn:Disconnect() specConn=nil end
            local cam=WS.CurrentCamera
            if cam then local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") if h then cam.CameraSubject=h end end
            setToggle(spBtn, false)
        end
        local function startSpec()
            if not sel then play(SND.error) fST.Text="no target" fST.TextColor3=C.bd return end
            local cam=WS.CurrentCamera if not cam then return end
            specOn=true if specConn then specConn:Disconnect() end
            specConn=RS.RenderStepped:Connect(function()
                if not specOn or not sel then return end
                local cam=WS.CurrentCamera if not cam then return end
                local hb=tRoot(activeFlingMode)
                if hb and hb.Parent and cam.CameraSubject~=hb then cam.CameraSubject=hb end
            end)
            setToggle(spBtn, true) play(SND.on)
        end

        onClick(tpBtn,function()
            if not sel then play(SND.error) fST.Text="no target" fST.TextColor3=C.bd return end
            local hb=tRoot(activeFlingMode)
            if not hb then play(SND.error) fST.Text="hitbox not loaded" fST.TextColor3=C.bd return end
            local c=LP.Character if not c then return end local mr=c:FindFirstChild("HumanoidRootPart") if not mr then return end
            local h=c:FindFirstChildOfClass("Humanoid") if h then if h.PlatformStand then h.PlatformStand=false end if h.Sit then h.Sit=false end end
            mr.CFrame=CFrame.new(hb.Position+Vector3.new(0,3,0))
            mr.AssemblyLinearVelocity=Vector3.zero mr.AssemblyAngularVelocity=Vector3.zero
            play(SND.success) fST.Text="teleported · "..sel.Name fST.TextColor3=C.tx
        end)

        local function stopFlingUI()
            wantFling=false autoRefling=false stopFling()
            avStop() akStop() agpStop() if csStop then csStop() end
            setToggle(headFlingBtn, false) setToggle(torsoFlingBtn, false)
            fST.Text="stopped" fST.TextColor3=C.tx3 play(SND.off)
        end

        local function forceRoastChatStart()
            csMode = "roast" csSym = "AT"
            csTgt = resolveTargetDisplay() or ""
            if _G.__VOIDChatSetBtn then _G.__VOIDChatSetBtn.Text="@" end
            if _G.__VOIDChatTargetBox and csTgt ~= "" then _G.__VOIDChatTargetBox.Text = csTgt end
            if csStart then pcall(csStart)
            else task.delay(0.4, function() if csStart then pcall(csStart) end end) end
        end

        local function startFlingUI(mode)
            if flinging then
                if activeFlingMode==mode then stopFlingUI() return else stopFlingUI() task.wait(.05) end
            end
            if not sel and not selName then play(SND.error) fST.Text="select a target first" fST.TextColor3=C.bd return end
            if faOn then faStop() end
            if not sel then
                wantFling=true activeFlingMode=mode autoRefling=true
                setToggle(headFlingBtn, mode=="head") setToggle(torsoFlingBtn, mode=="torso")
                fST.Text="armed · waiting for "..(selName or "target") fST.TextColor3=C.wn
                play(SND.success) return
            end
            wantFling=true autoRefling=true
            startFling(mode) avStart() akStart() agpStart() forceRoastChatStart()
            setToggle(headFlingBtn, mode=="head") setToggle(torsoFlingBtn, mode=="torso")
            fST.Text=mode=="head" and "head hitbox fling" or "torso hitbox fling" fST.TextColor3=C.tx play(SND.on)
        end

        onClick(headFlingBtn, function() startFlingUI("head") end)
        onClick(torsoFlingBtn, function() startFlingUI("torso") end)
        onClick(spBtn, function() if specOn then play(SND.off) stopSpec() else startSpec() end end)

        local tgtLbl=L(fp,"Target username · press Enter",9,C.tx3,F)
        tgtLbl.Size=UDim2.new(1,0,0,12) tgtLbl.Position=UDim2.new(0,0,0,290)
        local tgtInput=B(fp,"enter username")
        tgtInput.Size=UDim2.new(1,0,0,30) tgtInput.Position=UDim2.new(0,0,0,304) tgtInput.TextSize=11
        local tgtHint=L(fp,"",9,C.tx3,F)
        tgtHint.Size=UDim2.new(1,0,0,12) tgtHint.Position=UDim2.new(0,0,0,338)

        local lastHintState = nil
        registerUIPoller(function()
            local joined = sel ~= nil
            local offline = (not sel) and (selName ~= nil or selId ~= nil)
            if joined then
                local inS=false for _,p in ipairs(P:GetPlayers()) do if p==sel then inS=true break end end
                if not inS then joined = false; offline = true end
            end
            local state = joined and "joined" or (offline and "offline" or "none")
            if state ~= lastHintState then
                lastHintState = state
                if state == "joined" and (flinging or wantFling) then
                    tgtHint.Text = "target joined · flinging hitbox" tgtHint.TextColor3 = C.tx
                elseif state == "joined" then
                    tgtHint.Text = "target joined · ready" tgtHint.TextColor3 = C.tx
                elseif state == "offline" then
