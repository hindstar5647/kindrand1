                local trackAbs=track.AbsolutePosition local trackSz=track.AbsoluteSize
                if trackSz.X<=0 then return end
                local relX=math.clamp(input.Position.X-trackAbs.X,0,trackSz.X)
                local v=math.floor((relX/trackSz.X)*255+0.5)
                fill.Size=UDim2.new(relX/trackSz.X,0,1,0)
                val.Text=tostring(v)
                onChanged(v)
            end

