            track.BackgroundColor3=C.input track.BorderSizePixel=0 track.Parent=container
            corner(track,3)

            local fill=Instance.new("Frame")
            fill.Size=UDim2.new(math.clamp(initial/255,0,1),0,1,0)
            fill.BackgroundColor3=color fill.BorderSizePixel=0 fill.Parent=track
