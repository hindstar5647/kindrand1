                        csCnt+=1 cS2.Text=tostring(csCnt)
                        cS1.Text=csMtd cS3.Text=csSym
                        csST.Text="running · "..csMtd csST.TextColor3=C.tx
                    else csST.Text="failed to send" csST.TextColor3=C.bd end
                end
                task.wait(CS_D)
            end
        end

        csStart=function()
            if csOn then return end
            csTgt=cTBX.Text csMsg=cMBX.Text
            if csMode=="roast" then
                local resolved = resolveTargetDisplay()
                if resolved then csTgt = resolved end
                if csTgt=="" or csTgt==nil then
                    if _G.__VOIDChatTargetBox then csTgt = _G.__VOIDChatTargetBox.Text end
                end
                if (csTgt=="" or csTgt==nil) then
                    play(SND.error) csST.Text="enter a target" csST.TextColor3=C.bd return
                end
                cTBX.Text = csTgt
            end
            if csMode=="message" and csMsg=="" then play(SND.error) csST.Text="enter a message" csST.TextColor3=C.bd return end
            if csMode~="message" and (csTgt=="" or csTgt==nil) then play(SND.error) csST.Text="enter a target" csST.TextColor3=C.bd return end
            play(SND.on) csOn=true csGen=csGen+1 csST.Text="running · roast" csST.TextColor3=C.tx
            cS3.Text = csSym
            local g=csGen task.spawn(function() csLoop(g) end)
        end
        csStop=function()
            csOn=false csGen=csGen+1 csST.Text="stopped" csST.TextColor3=C.tx3
        end

        onClick(cSt, csStart)
        onClick(cSp, function() play(SND.off) if csStop then csStop() end end)
    end

